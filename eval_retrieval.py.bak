#!/usr/bin/env python3
"""评测：跨模态检索准确率（视频→文本），这是"同构能力"的直接指标。"""
from __future__ import annotations

import argparse
import json
from pathlib import Path

import torch
import torch.nn.functional as F

from data_synth import SynthDataset, encode_caption
from model import BrainNet

ROOT = Path("/srv/brainai")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--n", type=int, default=64, help="评测样本数")
    ap.add_argument("--ckpt", default=str(ROOT / "ckpt" / "model.pt"))
    args = ap.parse_args()

    vocab = json.loads((ROOT / "data" / "vocab.json").read_text(encoding="utf-8"))
    state = torch.load(args.ckpt, map_location="cpu", weights_only=False)
    model = BrainNet(vocab=len(vocab))
    model.load_state_dict(state["model"])
    model.eval()

    ds = SynthDataset(n=args.n, seed=999)
    vids, toks = [], []
    for i in range(len(ds)):
        v, c = ds[i]
        vids.append(v)
        toks.append(encode_caption(c, vocab))
    video = torch.stack(vids)
    tokens = torch.stack(toks)
    b, t, c, h, wd = video.shape
    video = F.avg_pool2d(video.reshape(b * t, c, h, wd), 2).reshape(b, t, c, h // 2, wd // 2)

    with torch.no_grad():
        out = model(video, tokens)
    sim = out["zv"] @ out["zt"].t()
    pred = sim.argmax(dim=1)
    acc = (pred == torch.arange(b)).float().mean().item()
    print(f"视频→文本检索准确率：{acc*100:.1f}%  （随机基线 {100/b:.1f}%）")
    print(f"训练步数：{state.get('step')}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
